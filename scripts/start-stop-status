case $1 in
    start)
        USER="sc-qBittorrent"  # 替换成你的实际运行用户
        CONFIG_DIR="/var/services/homes/${USER}/.config/qBittorrent"
        mkdir -p "${CONFIG_DIR}"
        chown -R "${USER}:${USER}" "/var/services/homes/${USER}/.config" 2>/dev/null
        su -s /bin/sh -c "/var/packages/qBittorrent/target/bin/qbittorrent-nox -d" "${USER}"
        ;;
    stop)
        pkill -u sc-qBittorrent qbittorrent-nox 2>/dev/null
        ;;
    status)
        pgrep -u sc-qBittorrent qbittorrent-nox > /dev/null
        exit $?
        ;;
esac
