#!/bin/bash

PKG_DIR="/var/packages/qBittorrent/target"
RUN_USER="qBittorrent" 
PKG_VAR="${PKG_DIR}/var"

case $1 in
    start)
        # 清理旧进程
        pkill -u ${RUN_USER} -f "qbittorrent-nox" 2>/dev/null
        sleep 1

        # 创建目录并赋权
        mkdir -p "${PKG_VAR}/config" "${PKG_VAR}/cache" "${PKG_VAR}/data"
        chown -R ${RUN_USER}:${RUN_USER} "${PKG_VAR}"

        # 注意这里：去掉了 -d 参数，改用 & 放到后台运行
        # 并且加了 > /dev/null 2>&1 防止输出卡住群晖的管道
        su -s /bin/bash ${RUN_USER} -c "\
            export HOME='${PKG_VAR}' \
            XDG_CONFIG_HOME='${PKG_VAR}/config' \
            XDG_CACHE_HOME='${PKG_VAR}/cache' \
            XDG_DATA_HOME='${PKG_VAR}/data' \
            ${PKG_DIR}/bin/qbittorrent-nox --webui-port=8085 > /dev/null 2>&1 &"
        ;;
    stop)
        pkill -u ${RUN_USER} -f "qbittorrent-nox" 2>/dev/null
        ;;
    status)
        pgrep -u ${RUN_USER} -f "qbittorrent-nox" > /dev/null
        exit $?
        ;;
esac
exit 0
