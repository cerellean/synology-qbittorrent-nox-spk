#!/bin/bash

PKG_DIR="/var/packages/qBittorrent/target"
# 改成大写的 qBittorrent
RUN_USER="qBittorrent" 

PKG_VAR="${PKG_DIR}/var"
CONF_DIR="${PKG_VAR}/config"
CACHE_DIR="${PKG_VAR}/cache"
DATA_DIR="${PKG_VAR}/data"

case $1 in
    start)
        pkill -f "qbittorrent-nox" 2>/dev/null
        sleep 1

        mkdir -p "${CONF_DIR}" "${CACHE_DIR}" "${DATA_DIR}"
        # 赋权给 qBittorrent 用户
        chown -R ${RUN_USER}:${RUN_USER} "${PKG_VAR}"

        su -s /bin/bash ${RUN_USER} -c "\
            export HOME='${PKG_VAR}' \
            XDG_CONFIG_HOME='${CONF_DIR}' \
            XDG_CACHE_HOME='${CACHE_DIR}' \
            XDG_DATA_HOME='${DATA_DIR}' \
            ${PKG_DIR}/bin/qbittorrent-nox -d --webui-port=8085"
        ;;
    stop)
        pkill -f "qbittorrent-nox" 2>/dev/null
        ;;
    status)
        pgrep -f "qbittorrent-nox" > /dev/null
        exit $?
        ;;
esac
exit 0
